# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Snowflake connection
# ---------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=your_account_identifier   # e.g. xy12345 or xy12345.us-east-1
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN                 # needs CREATE DATABASE, Cortex privileges
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# ---------------------------------------------------------------------------
# Census data source
# Install this free dataset from Snowflake Marketplace before running:
#   https://app.snowflake.com/marketplace/listing/GZSTZAXW9I/
#   "US Open Census Data: Neighborhood Insights (Free Dataset)"
# The database name below is the default after installation.
# ---------------------------------------------------------------------------
SNOWFLAKE_DATA_DATABASE=US_OPEN_CENSUS_DATA__NEIGHBORHOOD_INSIGHTS__FREE_DATASET
SNOWFLAKE_DATA_SCHEMA=PUBLIC

# ---------------------------------------------------------------------------
# Knowledge base (created automatically by scripts/build_kb.py)
# Choose any database and schema name — they will be created if absent.
# ---------------------------------------------------------------------------
SNOWFLAKE_KB_DATABASE=CENSUS_DATA_KB
SNOWFLAKE_KB_SCHEMA=PUBLIC

# Cortex Search service name (created by build_kb.py inside the KB database)
CORTEX_SEARCH_SERVICE=CBG_SEARCH

# ---------------------------------------------------------------------------
# LLM models (Cortex-hosted — no API keys needed, billed to your Snowflake account)
# Availability depends on your Snowflake region; defaults are valid for AWS us-west-2.
# ---------------------------------------------------------------------------
SQL_MODEL=mistral-large2
GENERATOR_MODEL=claude-sonnet-4-6
GUARDRAIL_MODEL=claude-haiku-4-5
